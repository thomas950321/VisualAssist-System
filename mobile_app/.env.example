# ========================================================
# VisualAssist System - 手機端環境變數設定範本
# 複製此檔案為 .env 並填入你的 Google Gemini API Key
# ========================================================

# 申請網址：https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 推薦使用 gemini-2.5-flash 或 gemini-1.5-flash，反應最快、支援音訊+圖片多模態
VITE_GEMINI_MODEL=gemini-2.5-flash
